---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChessBoard from '../components/ChessBoard.astro';
import Chapter from '../components/Chapter.astro';
import ContactSection from '../components/ContactSection.astro';
import { chapters } from '../data/chapters';
---
<BaseLayout title="Ved Bhatawadekar - Engineer, Researcher, Chess Player">
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Ved Bhatawadekar home"><span class="mark" aria-hidden="true">▦</span> Ved Bhatawadekar</a>
    <nav><a href="#game-record">Profile</a><a href="/consult">Consult</a><a href="/blog">Blog</a><a href="#contact">Contact</a></nav>
  </header>
  <main id="top">
    <section class="hero">
      <p class="eyebrow">MSc Informatics · University of Zurich</p>
      <p class="role">Research Assistant · ETH Zurich</p>
      <h1>Engineering for<br /><em>complex positions.</em></h1>
      <div class="hero-details"><span>Zurich, Switzerland</span></div>
      <a class="scroll-link" href="#game-record">Explore the game record <span>↓</span></a>
    </section>
    <section class="record" id="game-record" aria-labelledby="record-title">
      <div class="record-intro"><div class="record-heading"><p class="eyebrow">Why chess? I have played chess since I was eight </p><h2 id="record-title">Chess taught me<br />how to think.</h2></div><p>The board is a decoration: each move marks a chapter in my professional life. A creative way to tell my professional story.</p></div>
      <div class="record-layout">
        <ChessBoard />
        <div class="chapters">{chapters.map((chapter) => <Chapter chapter={chapter} />)}</div>
      </div>
    </section>
  </main>
  <ContactSection />
  <footer>© 2026 Ved Bhatawadekar <span>UZH & ETH Zürich</span></footer>
</BaseLayout>

<script>
  const chapterElements = [...document.querySelectorAll('[data-ply]')];
  let activeChapterIndex = 0;
  let keyboardTargetIndex = null;
  let observerFrame = null;
  function activateChapter(index) {
    if (index < 0 || index >= chapterElements.length || index === activeChapterIndex && chapterElements[index].classList.contains('is-active')) return;
    activeChapterIndex = index;
    chapterElements.forEach((chapter, chapterIndex) => chapter.classList.toggle('is-active', chapterIndex === activeChapterIndex));
    window.dispatchEvent(new CustomEvent('chapterchange', { detail: Number(chapterElements[index].getAttribute('data-ply')) }));
  }
  function activateNearestChapter() {
    if (keyboardTargetIndex !== null) return;
    const anchor = window.matchMedia('(max-width: 780px)').matches ? window.innerHeight * .72 : window.innerHeight * .52;
    const nearestIndex = chapterElements.reduce((closestIndex, chapter, index) => {
      const currentDistance = Math.abs(chapter.getBoundingClientRect().top + chapter.getBoundingClientRect().height / 2 - anchor);
      const closest = chapterElements[closestIndex].getBoundingClientRect();
      const closestDistance = Math.abs(closest.top + closest.height / 2 - anchor);
      return currentDistance < closestDistance ? index : closestIndex;
    }, 0);
    activateChapter(nearestIndex);
  }
  const observer = new IntersectionObserver(() => {
    if (observerFrame !== null) cancelAnimationFrame(observerFrame);
    observerFrame = requestAnimationFrame(() => {
      observerFrame = null;
      activateNearestChapter();
    });
  }, { rootMargin: '-15% 0px -15% 0px', threshold: [0, .1, .5, .9] });
  chapterElements.forEach((chapter) => observer.observe(chapter));
  activateChapter(0);
  window.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
    const direction = event.key === 'ArrowRight' ? 1 : -1;
    const nextIndex = Math.max(0, Math.min(chapterElements.length - 1, activeChapterIndex + direction));
    if (nextIndex === activeChapterIndex) return;
    event.preventDefault();
    keyboardTargetIndex = nextIndex;
    activateChapter(nextIndex);
    const block = window.matchMedia('(max-width: 780px)').matches ? 'end' : 'center';
    chapterElements[nextIndex].scrollIntoView({ behavior: 'smooth', block });
    window.setTimeout(() => {
      keyboardTargetIndex = null;
      activateNearestChapter();
    }, 900);
  });
</script>

<style>
  .site-header, main, footer { width:min(1080px, calc(100% - 3rem)); margin:auto; }
  .site-header { display:flex; justify-content:space-between; align-items:center; min-height:74px; border-bottom:1px solid var(--line); }
  .brand { display:flex; align-items:center; gap:.6rem; text-decoration:none; color:var(--ink); font:500 1rem 'Playfair Display',serif; }
  .mark { display:grid; place-items:center; width:1.8rem; height:1.8rem; color:var(--paper); background:var(--green); font-family:Arial,sans-serif; }
  nav { display:flex; gap:1.3rem; } nav a { color:var(--muted); text-decoration:none; font:.75rem 'DM Mono',monospace; text-transform:uppercase; }
  .hero { padding:clamp(5rem,14vw,9rem) 0 5rem; border-bottom:1px solid var(--line); }
  .eyebrow { margin:0; color:var(--gold); font:500 .75rem 'DM Mono',monospace; letter-spacing:.08em; text-transform:uppercase; }
  .hero h1, .record-intro h2, .current h2 { margin:.8rem 0 1.25rem; color:var(--green); font:500 clamp(3rem,8vw,6.5rem)/.96 'Playfair Display',serif; letter-spacing:-.045em; }
  .hero h1 em { color:var(--gold); font-style:normal; }
  .role { margin:.38rem 0 0; color:var(--green); font:500 .82rem 'DM Mono',monospace; letter-spacing:.04em; }
  .hero-details { display:flex; flex-wrap:wrap; gap:.5rem 1.25rem; margin-top:2rem; color:var(--muted); font:.78rem 'DM Mono',monospace; }
  .scroll-link { display:inline-flex; gap:.8rem; margin-top:3.2rem; color:var(--green); font:500 .82rem 'DM Mono',monospace; text-decoration:none; }
  .scroll-link span { color:var(--gold); }
  .record { padding:5rem 0; border-bottom:1px solid var(--line); }
  .record-intro { display:grid; grid-template-columns:1.4fr .8fr; gap:2rem; align-items:end; margin-bottom:3.5rem; }
  .record-heading { display:flex; align-items:baseline; gap:1.1rem; flex-wrap:wrap; }
  .record-heading .eyebrow { margin-bottom:.45rem; }
  .record-intro h2 { font-size:clamp(2.4rem,5vw,4.3rem); }
  .record-intro > p:last-child { max-width:31rem; margin:0 0 .5rem; color:var(--muted); }
  .record-layout { display:grid; grid-template-columns:minmax(16rem,.7fr) minmax(0,1fr); gap:clamp(2.5rem,7vw,6rem); align-items:start; }
  .chapters { min-width:0; }
  footer { display:flex; justify-content:space-between; gap:1rem; padding:0 0 2.3rem; color:var(--muted); font:.72rem 'DM Mono',monospace; text-transform:uppercase; }
  @media (max-width:780px) { .site-header, main, footer { width:min(100% - 2rem, 1080px); } .record-intro,.record-layout { grid-template-columns:1fr; } .record-intro { gap:.2rem; margin-bottom:2rem; } .record { padding:3.5rem 0; } .hero { padding:4rem 0 3.5rem; } }
</style>
